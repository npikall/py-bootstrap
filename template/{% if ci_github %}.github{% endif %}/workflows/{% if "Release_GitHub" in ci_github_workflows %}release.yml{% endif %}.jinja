# yaml-language-server: $schema=https://www.schemastore.org/github-workflow.json
name: Release
{% raw %}
on:
  push:
    tags:
      - "v*"

permissions: {}

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: false

jobs:
  release:
    name: Create GitHub release
    runs-on: ubuntu-latest
    permissions:
      contents: write  # needed to create GitHub releases
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
        with:
          fetch-depth: 0
          persist-credentials: false
{% endraw %}{% if changelog_tool == "git-changelog" %}
      - name: Install uv
        uses: astral-sh/setup-uv@fac544c07dec837d0ccb6301d7b5580bf5edae39 # v8.2.0
        with:
          version: "0.9.28"

      - name: Install git-changelog
        run: uv tool install git-changelog

      - name: Prepare release notes
        run: git-changelog --release-notes > release-notes.md
{% elif changelog_tool == "git-cliff" %}
      - name: Install git-cliff
        uses: taiki-e/install-action@9e1e5806d4a4822de933115878265be9aaa786d9 # v2.82.2
        with:
          tool: git-cliff

      - name: Run git-cliff
        run: git cliff -v --latest --no-exec --strip header --output release-notes.md
{% endif %}{% raw %}
      - name: Create release
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
        run: |
          gh release create ${GITHUB_REF_NAME} \
            --repo ${GH_REPO} \
            --title {% endraw %}"{{ project_name }}{% raw %} - ${GITHUB_REF_NAME}" \
            --notes-file release-notes.md \
            --fail-on-no-commits \
            --draft{% endraw %}
